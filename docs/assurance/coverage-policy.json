{
  "tolerance": 1.0,
  "exclude": [
    "RegexGenerator.g.cs",
    "Db2iEngine.cs"
  ],
  "critical": [
    "backend/src/Dbbliss.Backend/Backend.cs",
    "backend/src/Dbbliss.Backend/Rpc/ResultStreamer.cs",
    "backend/src/Dbbliss.Backend/Rpc/Output.cs",
    "backend/src/Dbbliss.Backend/Rpc/CsvExport.cs",
    "backend/src/Dbbliss.Backend/Engines/QueryControl.cs",
    "backend/src/Dbbliss.Backend/Engines/ValueConverter.cs",
    "backend/src/Dbbliss.Backend/Scripts/ScriptSplitter.cs",
    "backend/src/Dbbliss.Backend/Scripts/StatementClassifier.cs",
    "backend/src/Dbbliss.Backend/Credentials.cs",
    "backend/src/Dbbliss.Backend/Instances.cs",
    "backend/src/Dbbliss.Backend/Catalog/ObjectNames.cs",
    "backend/src/Dbbliss.Backend/Engines/PostgresEngine.cs",
    "backend/src/Dbbliss.Backend/Engines/SqlServerEngine.cs",
    "backend/src/Dbbliss.Backend/Engines/AdoStreaming.cs",
    "backend/src/Dbbliss.Backend/Engines/AdoQuery.cs",
    "backend/src/Dbbliss.Backend/Sessions/ISessionAdmin.cs",
    "backend/src/Dbbliss.Backend/Sessions/SessionIds.cs",
    "backend/src/Dbbliss.Backend/Sessions/PostgresSessions.cs",
    "backend/src/Dbbliss.Backend/Sessions/SqlServerSessions.cs",
    "backend/src/Dbbliss.Backend/Management/OperationManager.cs",
    "backend/src/Dbbliss.Backend/Management/PostgresManagement.cs",
    "backend/src/Dbbliss.Backend/Management/SqlServerManagement.cs",
    "backend/src/Dbbliss.Backend/Management/ProcessRunner.cs"
  ],
  "ignore_artifacts": [
    {
      "pattern": "^\\s*[{}]+[;)]*\\s*$",
      "reason": "A line holding only braces is not a statement. The compiler gives a closing brace a sequence point (after a throw, at the end of an async method) that no input can reach or miss."
    },
    {
      "pattern": "^\\s*throw;\\s*$",
      "reason": "The branch the tool attaches to a rethrow in a catch block of an async method is the compiler's state-machine plumbing around the await before it, not a decision in the source."
    }
  ]
}
