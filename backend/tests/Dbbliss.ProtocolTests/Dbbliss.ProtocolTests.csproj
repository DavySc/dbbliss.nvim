<Project Sdk="Microsoft.NET.Sdk">

  <!-- Protocol tests: the real Backend in-process, over pipes, against a fake engine that plays the
       server of spec/quint/client.qnt. A plain console runner, like the cancel suite (decision 12). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Dbbliss.ProtocolTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Dbbliss.Backend/Dbbliss.Backend.csproj" />
  </ItemGroup>

</Project>
