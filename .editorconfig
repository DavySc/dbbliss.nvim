root = true

# Verifies: HLR-DATA-1 (analysis: results do not depend on the machine's culture)
[*.cs]
# Culture-sensitive string operations behave differently on a Windows desktop with another
# locale (Turkish i, ignorable characters). Name the comparison.
dotnet_diagnostic.CA1310.severity = error
dotnet_diagnostic.CA1309.severity = error
dotnet_diagnostic.CA1311.severity = error
dotnet_diagnostic.CA1304.severity = error
dotnet_diagnostic.CA1307.severity = none
